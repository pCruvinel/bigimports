# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# JWT Configuration — Gere um secret forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_minimum_64_chars
JWT_EXPIRES_IN=7d

# n8n Webhook URLs
N8N_WEBHOOK_CREATE_INSTANCE=https://your-n8n-instance.com/webhook/create-instance
N8N_WEBHOOK_REGENERATE_QR=https://your-n8n-instance.com/webhook/regenerate-qrcode
N8N_WEBHOOK_DISCONNECT_INSTANCE=https://your-n8n-instance.com/webhook/disconnect-instance

# CORS Configuration — EM PRODUÇÃO, use o domínio real (ex: https://app.bigimports.com.br)
FRONTEND_URL=http://localhost:5173
